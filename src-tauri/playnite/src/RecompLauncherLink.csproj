<Project Sdk="Microsoft.NET.Sdk">
  <!-- A Playnite add-on (Playnite runs on .NET Framework 4.6.2). Built with
       tools/build-playnite-link.sh; the DLL it makes sits next to extension.yaml one folder up and
       goes into the launcher with include_bytes!. Deterministic, so the same source gives the same
       DLL byte for byte. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>RecompLauncherLink</AssemblyName>
    <RootNamespace>RecompLauncherLink</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=RecompLauncherLink</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
</Project>
